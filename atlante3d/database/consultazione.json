  "profiles": {
    "compositore-carl-nielsen": {
      "dates": "1865–1931",
      "place": "Nørre Lyndelse – Copenaghen · Danimarca",
      "summary": "Violinista, direttore e compositore danese. La sua produzione comprende sei sinfonie, le opere Saul og David e Maskarade, musica vocale, concerti e lavori cameristici."
    },
    "compositore-jean-sibelius": {
      "dates": "1865–1957",
      "place": "Hämeenlinna – Järvenpää · Finlandia",
      "summary": "Compositore finlandese, autore di sette sinfonie, del Concerto per violino e di poemi sinfonici come Finlandia e Il cigno di Tuonela. La sua musica elabora in modo originale temi del paesaggio e dell’identità culturale finlandese."
    },
    "compositore-leos-janacek": {
      "dates": "1854–1928",
      "place": "Hukvaldy – Ostrava · Moravia",
      "summary": "Compositore ceco, docente e direttore del conservatorio di Brno. È autore di Jenůfa, Káťa Kabanová, La volpe astuta, Sinfonietta e Taras Bulba; sviluppò un linguaggio originale anche a partire dalla tradizione musicale morava."
    },
    "compositore-ottaviano-petrucci": {
      "dates": "1466–1538",
      "place": "Fossombrone – Venezia · Italia",
      "summary": "Stampatore ed editore musicale, non compositore. Ottenne un privilegio veneziano nel 1498 e pubblicò nel 1501 l’Harmonice musices odhecaton, oltre a edizioni di polifonia con messe di Josquin e Obrecht."
    },
    "compositore-jerome-kern": {
      "dates": "1885–1945",
      "place": "New York · Stati Uniti",
      "summary": "Compositore statunitense attivo nel teatro musicale e nel cinema; scrisse la musica di Show Boat (1927), su libretto e versi di Oscar Hammerstein II."
    },
    "compositore-richard-rodgers": {
      "dates": "1902–1979",
      "place": "New York · Stati Uniti",
      "summary": "Compositore statunitense di Broadway, attivo prima con Lorenz Hart e poi con Oscar Hammerstein II. Fra i loro musical figurano Oklahoma!, Carousel, South Pacific e The Sound of Music."
    },
    "compositore-scott-joplin": {
      "dates": "1867/68–1917",
      "place": "Sedalia – New York · Stati Uniti",
      "summary": "Pianista e compositore afroamericano, figura centrale del ragtime e autore di Treemonisha; la sua scrittura pianistica fa della sincopazione un elemento strutturale."
    },
    "persona-georges-melies": {
      "dates": "1861–1938",
      "place": "Parigi – Orly · Francia",
      "summary": "Regista, illusionista e produttore francese, fra i pionieri del cinema fantastico e dei trucchi cinematografici; Le Voyage dans la Lune (1902) è tra le sue opere più note. Non era un compositore."
    }
  }
}
