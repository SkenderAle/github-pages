  "profiles": {
    "compositore-carl-nielsen": {
      "dates": "1865–1931",
      "place": "Nørre Lyndelse – Copenaghen · Danimarca",
      "summary": "Violinista, direttore e compositore danese. La sua produzione comprende sei sinfonie, le opere Saul og David e Maskarade, musica vocale, concerti e lavori cameristici."
    },
    "compositore-jean-sibelius": {
      "dates": "1865–1957",
      "place": "Hämeenlinna – Järvenpää · Finlandia",
      "summary": "Compositore finlandese, autore di sette sinfonie, del Concerto per violino e di poemi sinfonici come Finlandia e Il cigno di Tuonela. La sua musica elabora in modo originale temi del paesaggio e dell’identità culturale finlandese."
    },
    "compositore-leos-janacek": {
      "dates": "1854–1928",
      "place": "Brno (nato a Hukvaldy)",
      "summary": "Compositore moravo e autore di opere, amico documentato di Dvořák, con un linguaggio teatrale proprio."
    },
    "compositore-ottaviano-petrucci": {
      "dates": "1466–1538",
      "place": "Fossombrone – Venezia · Italia",
      "summary": "Stampatore ed editore musicale, non compositore. Ottenne un privilegio veneziano nel 1498 e pubblicò nel 1501 l’Harmonice musices odhecaton, oltre a edizioni di polifonia con messe di Josquin e Obrecht."
    },
    "compositore-jerome-kern": {
      "dates": "1885–1945",
      "place": "New York · Stati Uniti",
      "summary": "Compositore statunitense attivo nel teatro musicale e nel cinema; scrisse la musica di Show Boat (1927), su libretto e versi di Oscar Hammerstein II."
    },
    "compositore-richard-rodgers": {
      "dates": "1902–1979",
      "place": "New York · Stati Uniti",
      "summary": "Compositore statunitense di Broadway, attivo prima con Lorenz Hart e poi con Oscar Hammerstein II. Fra i loro musical figurano Oklahoma!, Carousel, South Pacific e The Sound of Music."
    },
    "compositore-scott-joplin": {
      "dates": "1867/68–1917",
      "place": "Sedalia – New York · Stati Uniti",
      "summary": "Pianista e compositore afroamericano, figura centrale del ragtime e autore di Treemonisha; la sua scrittura pianistica fa della sincopazione un elemento strutturale."
    },
    "persona-georges-melies": {
      "dates": "1861–1938",
      "place": "Parigi – Orly · Francia",
      "summary": "Regista, illusionista e produttore francese, fra i pionieri del cinema fantastico e dei trucchi cinematografici; Le Voyage dans la Lune (1902) è tra le sue opere più note. Non era un compositore."
    },
    "persona-agnes-de-mille": {
      "dates": "1905–1993",
      "place": "New York · Stati Uniti",
      "summary": "Coreografa, danzatrice e autrice statunitense, decisiva per il balletto narrativo e il musical. Ideò le coreografie di Rodeo su musica di Aaron Copland (1942) e lavorò a Oklahoma! (1943). Data di nascita e biografia redazionale verificate sulla Library of Congress; la voce Treccani riporta un anno di nascita discordante (1908)."
    },
    "compositore-astor-piazzolla": {
      "dates": "1921–1992",
      "place": "Mar del Plata – Buenos Aires; formazione a New York e Parigi",
      "summary": "Bandoneonista e compositore argentino, protagonista del nuevo tango. Allievo di Ginastera e Boulanger, integrò contrappunto e scrittura cameristica nella tradizione tanguera."
    },
    "compositore-alberto-ginastera": {
      "dates": "1916–1983",
      "place": "Buenos Aires – La Plata · Argentina; morte a Ginevra",
      "summary": "Compositore argentino, fra tradizioni musicali nazionali e tecniche colte novecentesche; insegnò composizione ad Astor Piazzolla."
    },
    "compositore-heitor-villa-lobos": {
      "dates": "1887–1959",
      "place": "Rio de Janeiro · Brasile; soggiorni a Parigi",
      "summary": "Compositore e direttore brasiliano, autore delle Bachianas brasileiras; integrò materiali delle tradizioni brasiliane con la scrittura musicale colta."
    },
    "compositore-ney-rosauro": {
      "dates": "n. 1952",
      "place": "Rio de Janeiro (nascita) · Brasília e Würzburg (studi)",
      "summary": "Percussionista, compositore e docente brasiliano, figura della letteratura concertante per marimba, formato fra Brasile e Germania. Sintesi redazionale su fonte Percussive Arts Society."
    },
    "compositore-alma-mahler": {
      "dates": "1879–1964",
      "place": "Vienna",
      "summary": "Compositrice di Lieder, attiva a Vienna; il matrimonio con Gustav Mahler non esaurisce la sua produzione."
    },
    "compositore-lili-boulanger": {
      "dates": "1893–1918",
      "place": "Parigi",
      "summary": "Compositrice francese, vincitrice del Prix de Rome nel 1913, autrice di musica vocale e orchestrale."
    },
    "compositore-rebecca-clarke": {
      "dates": "1886–1979",
      "place": "Londra (Harrow)",
      "summary": "Compositrice e violista, autrice della Sonata per viola e pianoforte del 1919."
    },
    "compositore-edward-elgar": {
      "dates": "1857–1934",
      "place": "Worcester (nascita a Broadheath)",
      "summary": "Compositore inglese, autore di sinfonie, oratori e concerti; Richard Strauss ne riconobbe pubblicamente il valore."
    },
    "compositore-alexander-glazunov": {
      "dates": "1865–1936",
      "place": "San Pietroburgo",
      "summary": "Compositore e sinfonista russo, allievo di Rimskij-Korsakov."
    },
    "compositore-joachim-raff": {
